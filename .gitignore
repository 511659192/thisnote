# ---------- node / frontend ----------
node_modules/
frontend/host/dist/
frontend/host/.vite/
frontend/host/coverage/
frontend/host/pnpm-lock.yaml
.vite/
*.tsbuildinfo
*.iml

# ---------- java / backend ----------
# 注意：gitignore 不支持行内 # 注释，注释必须独立成行，否则整行变成字面文件名规则
backend/app/target/
target/
*.class
*.jar
.mvn/wrapper/maven-wrapper.jar
logs/

# ---------- 前端构建产物（pnpm build / Vite 产物，不入库） ----------
frontend/plugins/*/dist/

# ---------- 外置插件交付物（package 阶段从各模块 target 拷贝而来，不入库） ----------
backend/runtime/plugins/
frontend/runtime/plugins/
backend/plugins-dev/

# ---------- 历史：outDir 曾少写 backend/ 时误落的产物目录（防再生成；plugin-api 是源码，放行） ----------
frontend/plugin-*/
!frontend/plugin-api/

# ---------- runtime data (never commit user notes) ----------
.thisnote/
*.db
*.db-wal
*.db-shm
/notes/
attachments/
snapshots/

# ---------- local tooling ----------
.agent/tmp_*
.codex/
tools/__pycache__/
*.pyc
.vscode/
.idea/
*.log
docs/
graphify-out/
Thumbs.db
.DS_Store
.agents
.agent
.archify