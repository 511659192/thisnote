<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.thisnode</groupId>
    <artifactId>thisnode-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>thisnode-backend</artifactId>
  <name>thisnode-backend</name>
  <description>thisnode local backend (REST + SQLite/MySQL + Markdown mirror)</description>

  <dependencies>
    <!-- 插件契约 + 插件侧共享支持。插件本体（favorite / memory-curve / baidu-pan）**不在**这里：
         它们是 plugins/ 目录里各自独立的 jar，由 PF4J/SBP 在运行期装载 —— 核心编译期看不见它们，
         所以换/加/删一个插件都不需要重新打包应用。见 docs/PLUGIN_PLATFORM.md。

         （与 sbp-core 同样的共享方式）。 -->
    <dependency>
      <groupId>com.thisnode</groupId>
      <artifactId>plugin-api</artifactId>
    </dependency>

    <!-- SBP（Spring Boot Plugin Framework）：把单体变成可热装卸的模块化应用。
         它构建在 PF4J 之上，插件就是一个独立的 Spring Boot 工程（自带 Controller/静态资源/持久化）。
         版本由父 pom 锁。见 docs/PLUGIN_PLATFORM.md。 -->
    <dependency>
      <groupId>org.laxture</groupId>
      <artifactId>sbp-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pf4j</groupId>
      <artifactId>pf4j</artifactId>
    </dependency>

    <!-- Spring Web。Jackson 现在没有任何一方在借了：notes 插件的 meta 已改用 fastjson2（插件经父加载器
         拿到平台那份 fastjson2），HTTP 的 JSON 也一直是 fastjson2 转换器在处理。这里仍不把 Jackson
         排掉——它是 starter-web 传递引入的，要摘得另做一轮，确认 Boot 内部没有别的地方在用。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- fastjson2：平台自己的 JSON（插件状态文件的读写 + HTTP 的 JSON）。 -->
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2-extension-spring6</artifactId>
    </dependency>
    <!-- AOP：Spring 代理的基础（@Transactional / @Async 之类注解生效的前提）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>thisnode-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        交付形态是两份东西：应用 jar + backend/plugins-dist/ 目录里的插件 jar。
        插件 jar 由各自模块产出，这里在 package 阶段把它们拷到 plugins-dist/，
        所以 `mvn package` 之后从 backend/ 直接 `java -jar app/target/thisnode-backend.jar` 就能用，
        不需要手工 cp。destFileName 固定成与 plugin.properties 里 plugin.id 一致的名字。
        单独构建本模块时（-pl app）插件不在反应堆里，用 -am 或先跑整仓构建。
      -->
    </plugins>
  </build>
</project>
