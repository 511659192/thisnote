<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.thisnode</groupId>
    <artifactId>thisnode-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>plugin-api</artifactId>
  <name>thisnode-plugin-api</name>
  <description>插件契约：描述符、生命周期、配置、状态存储、以及访问笔记的门面</description>

  <!--
    依赖刻意压到最小：只有 Spring 的注解（@Component）与 PF4J 的契约类型。
    没有 spring-web、没有 jdbc、没有 Jackson —— 契约层不该把实现技术栈强加给插件作者。
  -->
  <dependencies>
    <dependency>
      <groupId>org.pf4j</groupId>
      <artifactId>pf4j</artifactId>
      <version>3.16.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
  </dependencies>
</project>
