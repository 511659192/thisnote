<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.thisnode</groupId>
    <artifactId>thisnode-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>plugin-favorite</artifactId>
  <name>thisnode-plugin-favorite</name>
  <properties>
    <plugin.id>favorite</plugin.id>
  </properties>

  <description>收藏插件：笔记级的 ★ 收藏（实体插件参考实现）</description>

  <!--
    依赖面 = 契约 + 插件侧共享支持（插件基类）+ SBP。它没有自己的表 —— 收藏是纯 per-entity 状态，
    落在盆底的 plugin_data 里；唯一的一次性迁移负责把核心原来的 nodes.favorite 搬过来并删掉那一列。
    没有 mapper，所以不需要 MyBatis。依赖版本一律由父 pom 锁，运行期由主应用提供。
  -->
  <dependencies>
    <dependency>
      <groupId>com.thisnode</groupId>
      <artifactId>plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.laxture</groupId>
      <artifactId>sbp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- SBP 插件入口需要 @SpringBootApplication（spring-boot-autoconfigure）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 交付：把自己的 jar 拷到 backend/plugins-dist/（界面资源由界面侧自行交付，不经这里）。
           在插件模块做而非主体 dependency:copy —— 后者从本地仓库解析，可能拿到陈旧构件
           （踩过：plugins-dist/ 里是 Oct 2 的旧 jar）。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-plugin-jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                      tofile="${project.basedir}/../../plugins-dist/${plugin.id}.jar" overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
