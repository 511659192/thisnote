<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.thisnote</groupId>
  <artifactId>thisnote-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>thisnote-backend</name>
  <description>
    thisnote 后端父工程：插件契约（plugin-api）、各插件（独立构件）、应用（app）。
    插件只依赖 plugin-api（外加 SBP 框架本身）—— 编译期就看不到核心内部类，因此可以单独发版、单独替换 jar。
    仓库根只作普通工作区，不放 Maven 文件；Maven 构建全部从本目录（backend/）进行。
  </description>

  <modules>
    <module>plugin-api</module>
    <module>plugins/ai</module>
    <module>plugins/memory-cycle</module>
    <module>plugins/notes</module>
    <module>plugins/favorite</module>
    <module>plugins/baidu-sync</module>
    <module>plugins/card-importer</module>
    <module>plugins/attachment-importer</module>
    <module>plugins/state-reset</module>
    <module>plugins/graphify</module>
    <module>plugins/tags</module>
    <module>plugins/ai-summary</module>
    <module>plugins/guide</module>
    <module>app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <pf4j.version>3.16.0</pf4j.version>
    <sbp.version>3.5.27</sbp.version>
    <lombok.version>1.18.40</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <fastjson2.version>2.0.61</fastjson2.version>
    <hutool.version>5.8.40</hutool.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 自家模块：版本只在父 pom 里写一次，子模块声明时不带版本 -->
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-memory-cycle</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-favorite</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-baidu-sync</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-card-importer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-attachment-importer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-state-reset</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-graphify</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-tags</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.thisnote</groupId>
        <artifactId>plugin-guide</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Lombok：编译期生成构造器/getter 等样板。版本由 spring-boot-starter-parent 统一管理。
           插件侧声明为 provided —— 注解在编译期就被处理掉，运行时不需要它。 -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
      </dependency>

      <!-- MapStruct：编译期生成 DTO 与 PO 的映射实现。 -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <!-- fastjson2：后端 HTTP JSON 转换所用的库。版本只在这里写一次。 -->
      <dependency>
        <groupId>com.alibaba.fastjson2</groupId>
        <artifactId>fastjson2</artifactId>
        <version>${fastjson2.version}</version>
      </dependency>

      <!-- fastjson2 的 Spring 6 适配：HttpMessageConverter（把 HTTP 的 JSON 交给 fastjson2）。 -->
      <dependency>
        <groupId>com.alibaba.fastjson2</groupId>
        <artifactId>fastjson2-extension-spring6</artifactId>
        <version>${fastjson2.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-core</artifactId>
        <version>${hutool.version}</version>
      </dependency>

      <!-- SBP（Spring Boot Plugin Framework）：版本只在这里写一次。 -->
      <dependency>
        <groupId>org.laxture</groupId>
        <artifactId>sbp-core</artifactId>
        <version>${sbp.version}</version>
      </dependency>
      <dependency>
        <groupId>org.laxture</groupId>
        <artifactId>sbp-spring-boot-starter</artifactId>
        <version>${sbp.version}</version>
      </dependency>
      <!-- PF4J 是 SBP 的底座；核心代码直接用它的 PluginManager/PluginWrapper，所以显式声明，
           版本与 SBP 依赖的那份保持一致。Spring Boot 的 BOM 不管 PF4J，因此必须在这里锁一次，
           插件与应用才会拿到同一个版本。 -->
      <dependency>
        <groupId>org.pf4j</groupId>
        <artifactId>pf4j</artifactId>
        <version>${pf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${java.version}</release>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      插件 jar 的描述符版本由 Maven 版本注入（`plugin.version=@project.version@`），
      这里只负责把 plugin.properties 打开过滤。用 Spring Boot 父 pom 的 `@…@` 分隔符，
      避免与其它 `${…}` 占位符（例如插件配置里的占位符）冲突。
    -->
    <profile>
      <id>plugins</id>
      <activation>
        <file>
          <exists>src/main/resources/plugin.properties</exists>
        </file>
      </activation>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
            <filtering>true</filtering>
            <includes>
              <include>plugin.properties</include>
            </includes>
          </resource>
          <resource>
            <directory>src/main/resources</directory>
            <filtering>false</filtering>
            <excludes>
              <exclude>plugin.properties</exclude>
            </excludes>
          </resource>
        </resources>
      </build>
    </profile>
  </profiles>
</project>
