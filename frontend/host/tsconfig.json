{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@thisnode/plugin-api": ["../../frontend-plugin-api/src/index.ts"],
      "@plugin/memory-curve": ["../../plugin-memory-curve/frontend/index.ts"],
      "@plugin/favorite": ["../../plugin-favorite/frontend/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts", "../../plugin-*/frontend/**/*.ts", "../../plugin-*/frontend/**/*.vue"]
}
