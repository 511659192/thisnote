{
  "name": "thisnote-workspace",
  "private": true,
  "description": "thisnote 韧知笔记 —— pnpm 工作区根（界面侧主应用 + 插件微应用）",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:host": "pnpm --filter thisnote-frontend dev",
    "dev:plugins": "pnpm --filter @thisnote/plugin-favorite --filter @thisnote/plugin-memory-cycle --filter @thisnote/plugin-baidu-sync --filter @thisnote/plugin-card-importer --filter @thisnote/plugin-attachment-importer --filter @thisnote/plugin-state-reset --filter @thisnote/plugin-graphify --filter @thisnote/plugin-tags --filter @thisnote/plugin-ai --parallel dev"
  }
}
